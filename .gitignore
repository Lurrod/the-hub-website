# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets ignored, template committed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploads (servis via /api/images ; volume en prod)
/uploads

# Outillage design-sync (local, non lie au projet)
.ds-sync/

# Sorties Playwright
/test-results/
/playwright-report/

# Outillage d'agents de code : instructions, memoire, notes de travail.
# Local par choix — ces fichiers decrivent comment on outille le developpement,
# pas le produit. Ils changent au rythme des outils et pollueraient l'historique.
# AGENTS.md est en plus reecrit par `next dev` a chaque demarrage : le laisser
# suivi rendait l'arbre sale en permanence.
/.claude/
/CLAUDE.md
/AGENTS.md
/GEMINI.md
/.cursorrules
/.mcp.json
.superpowers/
.claude-mem/

# Direction artistique (charte complete, decisions visuelles). Local.
# Les deux casses sont listees : la CI tourne sous Linux, ou la comparaison
# est sensible a la casse.
/DESIGN.md
/design.md

# Rapports d'audit : livrables ponctuels, transmis hors depot.
/audit/

# Exploitation : deploy/apache.conf, docs/DEPLOIEMENT.md et
# docs/RGPD-EFFACEMENT.md sont desormais versionnes. Ils etaient tenus hors
# depot au motif qu'il serait public : il ne l'est pas. Ils n'existaient donc
# qu'en un exemplaire, sur un seul disque, sans sauvegarde -- alors que ce
# sont la configuration du serveur et la procedure d'effacement RGPD.
# Aucun secret n'y figure : les valeurs vivent dans shared/.env sur le Kimsufi.
# Seules les notes de travail des agents restent ignorees.
/docs/superpowers/

# Caches d'outillage tiers
.ruff_cache/
