generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  discordId     String?   @unique
  /// Pseudo Discord (@handle), rafraîchi à chaque connexion. `name` porte le
  /// nom d'affichage, qui ne permet pas de retrouver le compte.
  discordUsername String?
  globalRole    Role      @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  teamsCreated     Team[]        @relation("TeamCreatedBy")
  teamManagerRoles TeamManager[]
  tournamentsCreated     Tournament[]        @relation("TournamentCreatedBy")
  tournamentManagerRoles TournamentManager[]
  player                 Player?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

enum TeamStatus {
  ACTIVE
  INACTIVE
}

model Team {
  id          String       @id @default(cuid())
  // Pas de contrainte SQL sur name/tag : les jeux de démonstration importent
  // les mêmes équipes réelles depuis deux sources (`seed-dev` et
  // `seed-vlr-emea`), et la CI joue les deux. L'unicité est vérifiée à la
  // saisie — voir `findTeamConflict` — là où elle a un sens pour l'utilisateur.
  name        String
  tag         String
  logo        String?
  region      String
  description String?
  socials     Json?
  status          TeamStatus   @default(ACTIVE)
  /// Pendant du LFT côté équipe : « on recrute ». Même paire drapeau +
  /// horodatage que `Player.lft`, pour trier les annonces les plus fraîches.
  lfp             Boolean      @default(false)
  lfpSince        DateTime?
  /// Postes recherchés. Vide = ouvert à tous les rôles.
  lfpRoles        ValorantRole[] @default([])
  /// Précision libre de l'annonce (niveau attendu, disponibilités…).
  lfpMessage      String?
  inviteToken     String?      @unique
  inviteExpiresAt DateTime?
  createdById String?
  createdBy   User?        @relation("TeamCreatedBy", fields: [createdById], references: [id])
  managers    TeamManager[]
  memberships TeamMembership[]
  participations TournamentParticipant[]
  matchesAsA Match[] @relation("MatchTeamA")
  matchesAsB Match[] @relation("MatchTeamB")
  matchesWon Match[] @relation("MatchWinner")
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([region])
  // Créé par la migration 20260805180000_team_lfp mais jamais déclaré ici :
  // le schéma et la base avaient divergé, et la migration suivante proposait
  // de supprimer l'index. Il sert la page LFP, qui filtre sur ce drapeau.
  @@index([lfp])
}

/**
 * Deux niveaux de gestion, pour que l'ajout d'un manager ne revienne pas à
 * céder l'équipe : un MANAGER gère le quotidien (fiche, roster, inscriptions),
 * un OWNER peut en plus supprimer l'équipe et administrer les managers.
 */
enum ManagerRole {
  OWNER
  MANAGER
}

model TeamManager {
  id     String      @id @default(cuid())
  teamId String
  userId String
  role   ManagerRole @default(MANAGER)
  team   Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

enum MembershipRole {
  JOUEUR
  SUB
  COACH
  MANAGER
}

/// Ce que la personne vient faire sur le site, déclaré à l'inscription.
/// Distinct de `MembershipRole`, qui dit le rôle tenu dans une équipe donnée :
/// on peut se déclarer coach et rejoindre une équipe comme joueur.
enum AccountType {
  JOUEUR
  COACH
  MANAGER
}

model Player {
  id          String           @id @default(cuid())
  pseudo      String
  realName    String?
  nationality String?
  photo       String?
  userId      String?          @unique
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  socials     Json?
  riotName    String?
  riotTag     String?
  puuid       String?          @unique
  region      String?
  valorantRole ValorantRole?
  birthdate    DateTime?
  accountType  AccountType      @default(JOUEUR)
  /// Fin de l'inscription. C'était le Riot ID qui en tenait lieu ; il est
  /// devenu facultatif pour un coach ou un manager, qui n'ont pas forcément
  /// de compte de jeu à lier. Les fiches inscrites avant ce champ restent
  /// reconnues par leur `puuid`, d'où l'absence de reprise de données.
  onboardedAt  DateTime?
  lft          Boolean          @default(false)
  lftSince     DateTime?
  /// Le Discord du compte lié s'affiche d'office sur la fiche publique ; ce
  /// drapeau laisse au joueur la possibilité de le retirer.
  showDiscord  Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  memberships TeamMembership[]
  gameStats   PlayerGameStat[]
}

enum ValorantRole {
  DUELIST
  CONTROLLER
  INITIATOR
  SENTINEL
}

model TeamMembership {
  id        String         @id @default(cuid())
  teamId    String
  playerId  String
  role      MembershipRole @default(JOUEUR)
  joinDate  DateTime       @default(now())
  leaveDate DateTime?
  team      Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player    Player         @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([playerId])
  // Invariant §1.4 : un joueur = une seule adhésion active (leaveDate IS NULL).
  // Index unique PARTIEL non exprimable ici → défini en SQL brut dans la
  // migration 20260725201000_active_membership_unique.
}

enum TournamentFormat {
  GROUPS
  SINGLE_ELIM
  DOUBLE_ELIM
  GROUPS_THEN_ELIM
  SWISS
  ROUND_ROBIN
  LEAGUE
}

enum TournamentStatus {
  UPCOMING
  ONGOING
  FINISHED
}

model Tournament {
  id           String                  @id @default(cuid())
  name         String
  logo         String?
  banner       String?
  region       String
  startDate    DateTime?
  endDate      DateTime?
  format       TournamentFormat        @default(GROUPS)
  status       TournamentStatus        @default(UPCOMING)
  prizePool    String?
  organizer    String?
  description  String?
  /// Réseaux de l'organisation (même forme que `Team.socials`) : c'est là que
  /// les joueurs trouvent le Discord du tournoi.
  socials      Json?
  maxTeams     Int?
  groupSize    Int?
  bestOf       Int?
  seeding      String?
  createdById  String?
  createdBy    User?                   @relation("TournamentCreatedBy", fields: [createdById], references: [id])
  managers     TournamentManager[]
  participants TournamentParticipant[]
  groups   Group[]
  matches  Match[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([region])
  @@index([status])
}

model TournamentManager {
  id           String      @id @default(cuid())
  tournamentId String
  userId       String
  role         ManagerRole @default(MANAGER)
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tournamentId, userId])
}

model TournamentParticipant {
  id           String     @id @default(cuid())
  tournamentId String
  teamId       String
  seed         Int?
  groupId      String?
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  group        Group?     @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([tournamentId, teamId])
  // Pas de contrainte unique sur (tournamentId, seed) : les jeux de
  // démonstration importés numérotent les seeds PAR POULE, donc en double au
  // sein d'un même tournoi. L'unicité par tournoi reste la règle des
  // formulaires, appliquée transactionnellement dans `addParticipantAction`.
}

enum MatchStage {
  GROUP
  BRACKET
}

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
}

model Group {
  id           String                  @id @default(cuid())
  tournamentId String
  name         String
  tournament   Tournament              @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  matches      Match[]
  participants TournamentParticipant[]

  @@index([tournamentId])
}

model Match {
  id              String      @id @default(cuid())
  tournamentId    String
  groupId         String?
  teamAId         String
  teamBId         String
  scoreA          Int         @default(0)
  scoreB          Int         @default(0)
  winnerId        String?
  stage           MatchStage  @default(GROUP)
  round           String?
  bracketPosition Int?
  bestOf          Int         @default(1)
  status          MatchStatus @default(SCHEDULED)
  date            DateTime?
  /// L'heure de `date` est-elle significative ? Les matchs saisis avant
  /// l'ajout du champ horaire portent minuit, qui ne veut rien dire : sans ce
  /// drapeau ils afficheraient une heure de coup d'envoi inventée.
  hasTime         Boolean     @default(false)
  vodUrl          String?
  statsStatus     String?
  statsFetchedAt  DateTime?
  tournament      Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  group           Group?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  teamA           Team        @relation("MatchTeamA", fields: [teamAId], references: [id], onDelete: Cascade)
  teamB           Team        @relation("MatchTeamB", fields: [teamBId], references: [id], onDelete: Cascade)
  winner          Team?       @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)
  maps            MatchMap[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([tournamentId])
  @@index([groupId])
  @@index([status])
  // Toutes les vues « équipe » filtrent sur OR: [teamAId, teamBId] : sans ces
  // deux index, chaque fiche d'équipe balayait la table des matchs.
  @@index([teamAId])
  @@index([teamBId])
  // Les listes de matchs (accueil, index, fiche équipe) trient toutes par date.
  @@index([date])
}

model MatchMap {
  id      String @id @default(cuid())
  matchId String
  mapName String
  scoreA  Int
  scoreB  Int
  order       Int              @default(0)
  riotMatchId String?          @unique
  startedAt   DateTime?
  durationSec Int?
  roundTimeline Json?
  stats       PlayerGameStat[]
  match       Match            @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([matchId])
}

model PlayerGameStat {
  id         String    @id @default(cuid())
  matchMapId String
  playerId   String?
  riotName   String
  riotTag    String?
  puuid      String?
  teamSide   String
  agent      String?
  kills      Int
  deaths     Int
  assists    Int
  acs        Int
  adr        Int
  hsPct      Int
  rating      Float    @default(0)
  kast        Int      @default(0)
  firstKills  Int      @default(0)
  firstDeaths Int      @default(0)
  matchMap   MatchMap  @relation(fields: [matchMapId], references: [id], onDelete: Cascade)
  player     Player?   @relation(fields: [playerId], references: [id], onDelete: SetNull)

  @@index([matchMapId])
  @@index([playerId])
  // `setPlayerRiotAccount` recale les lignes d'un puuid à chaque liaison de
  // compte Riot, et le rattachement à l'import se fait par ce même champ.
  @@index([puuid])
}
