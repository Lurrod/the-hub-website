# Copier ce fichier en .env.local puis renseigner les vraies valeurs.
# .env.local n'est JAMAIS commité (voir .gitignore).

# Base PostgreSQL locale — remplacer <password> par le mot de passe du rôle postgres.
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/thehub"

# Secret de session Auth.js — générer avec: npx auth secret
AUTH_SECRET="change-me-generate-with-npx-auth-secret"

# Application Discord Developer (OAuth2)
# Redirect URI à déclarer dans le portail Discord : http://localhost:3200/api/auth/callback/discord
AUTH_DISCORD_ID="your-discord-app-client-id"
AUTH_DISCORD_SECRET="your-discord-app-client-secret"

# Discord IDs des 2 admins initiaux (séparés par une virgule)
ADMIN_DISCORD_IDS="DISCORD_USER_ID_1,DISCORD_USER_ID_2"

# URL de base (dev) — port 3200 pour éviter les conflits avec d'autres sites
NEXTAUTH_URL="http://localhost:3200"

# URL publique absolue pour construire les liens d'invitation copiables (optionnel).
# Si absente, un chemin relatif /rejoindre/<token> est affiché (fonctionnel en local).
NEXT_PUBLIC_BASE_URL="http://localhost:3200"

# Clé API HenrikDev (https://docs.henrikdev.xyz) pour la vérification des Riot ID
# et la synchronisation du Premier français.
HENRIKDEV_API_KEY=

# Secret de déclenchement de POST /api/premier/sync, appelé par la crontab du
# serveur. Sans lui la route refuse tout : elle écrit en base sans session.
# Générer avec: openssl rand -hex 32
PREMIER_SYNC_SECRET=
